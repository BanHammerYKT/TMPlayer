{
  "name": "TMPlayer Web",
  "short_name": "TMPlayer",
  "description": "A player for the videos already in your own Telegram chats, in the browser. Unofficial, not affiliated with Telegram.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "auto",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "categories": ["entertainment", "video", "utilities"],
  "background_color": "#0C0E10",
  "theme_color": "#0C0E10",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/desktop-grid.webp", "sizes": "1920x1200", "type": "image/webp", "form_factor": "wide", "label": "A chat's videos as a poster grid on a computer" },
    { "src": "screenshots/phone-grid.webp", "sizes": "1080x2400", "type": "image/webp", "form_factor": "narrow", "label": "A chat's videos as a poster grid on a phone" },
    { "src": "screenshots/phone-chats.webp", "sizes": "1080x2400", "type": "image/webp", "form_factor": "narrow", "label": "Your chats on a phone" }
  ]
}
