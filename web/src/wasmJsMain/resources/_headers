# Cloudflare Pages headers for web.tmplayer.org (what web/vercel.json set before).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

/*.wasm
  ! Cache-Control
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.worker.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  ! Cache-Control
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json

# The link preview and the install screenshots keep their names when redrawn: a day, so a new one
# reaches the crawlers and the install sheet soon, as the site does for its unversioned images.
/og.png
  ! Cache-Control
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/screenshots/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
